---
import { educacion, skills } from '../data/profile.ts';
---

<section class="section" id="formacion">
  <div class="wrap">
    <div class="two">
      <div>
        <div class="sec-hd"><span>Formación</span><span class="ln"></span></div>
        {educacion.map(e => (
          <div class="edu-item">
            <h3>{e.titulo}</h3>
            <p>{e.institucion}</p>
            <span class="yr">{e.detalle}</span>
          </div>
        ))}
      </div>

      <div>
        <div class="sec-hd"><span>Tecnologías</span><span class="ln"></span></div>
        <dl class="skl">
          {skills.map(s => (
            <div class="skl-row">
              <dt>{s.area}</dt>
              <dd>{s.items}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  @media (max-width: 760px) {
    .two { grid-template-columns: 1fr; gap: 24px; }
  }

  .edu-item { padding: 12px 0; border-top: 1px solid var(--line-soft); }
  .edu-item:first-of-type { border-top: none; padding-top: 0; }
  .edu-item h3 {
    font-size: 14.5px;
    font-weight: 600;
    margin: 0 0 2px;
    letter-spacing: -.012em;
  }
  .edu-item p { font-size: 13px; color: var(--ink-2); margin: 0; }
  .yr {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: .05em;
  }

  .skl { margin: 0; display: flex; flex-direction: column; gap: 11px; }
  .skl-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 12px;
    align-items: baseline;
  }
  @media (max-width: 480px) {
    .skl-row { grid-template-columns: 1fr; gap: 4px; }
  }
  .skl-row dt {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .skl-row dd {
    margin: 0;
    font-size: 13.5px;
    color: var(--ink);
    line-height: 1.5;
  }
</style>
