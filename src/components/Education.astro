---
import { t, type Lang } from '../i18n/index.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<section id="education" class="section" style="background: var(--color-bg-secondary);">
  <div class="section-inner">
    <div class="section-header fade-up">
      <span class="section-label">{t('education.section_label', lang)}</span>
      <h2>{t('education.title', lang)}</h2>
    </div>

    <div class="edu-grid">
      <!-- University -->
      <div class="fade-up" data-delay="50">
        <h3 class="edu-subtitle mono eyebrow" style="margin-bottom:1.5rem;">{t('education.university_label', lang)}</h3>
        <div class="edu-list">
          <div class="edu-item">
            <span class="edu-period mono">2024 — actualidad</span>
            <div>
              <p class="edu-degree">Ingeniería en Software</p>
              <p class="edu-school">Universidad Siglo 21</p>
            </div>
          </div>
          <div class="edu-item">
            <span class="edu-period mono">2020 — 2024</span>
            <div>
              <p class="edu-degree">Ingeniería en Sistemas</p>
              <p class="edu-school">UTN Córdoba</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Courses -->
      <div class="fade-up" data-delay="100">
        <h3 class="edu-subtitle mono eyebrow" style="margin-bottom:1.5rem;">{t('education.courses_label', lang)}</h3>
        <div class="edu-list">
          <div class="edu-item">
            <span class="edu-period mono">2025</span>
            <div>
              <p class="edu-degree">Científico de Datos asociado en Python</p>
              <p class="edu-school">DataCamp</p>
            </div>
          </div>
          <div class="edu-item">
            <span class="edu-period mono">2024</span>
            <div>
              <p class="edu-degree">Modern Data Analyst</p>
              <p class="edu-school">Udemy</p>
            </div>
          </div>
          <div class="edu-item">
            <span class="edu-period mono">2023</span>
            <div>
              <p class="edu-degree">Redes Neuronales con Python</p>
              <p class="edu-school">FaMAF — UNC</p>
            </div>
          </div>
          <div class="edu-item">
            <span class="edu-period mono">2022</span>
            <div>
              <p class="edu-degree">Curso Avanzado de JavaScript</p>
              <p class="edu-school">Coderhouse</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.edu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
}

.edu-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.edu-item {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
}

.edu-period {
  font-size: 0.75rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.02em;
  min-width: 90px;
  padding-top: 0.15rem;
  flex-shrink: 0;
}

.edu-degree {
  font-size: 0.9375rem;
  color: var(--color-text-primary);
  font-weight: 500;
  margin: 0 0 0.2rem;
}

.edu-school {
  font-size: 0.875rem;
  color: var(--color-text-secondary);
  margin: 0;
}

@media (max-width: 700px) {
  .edu-grid { grid-template-columns: 1fr; gap: 2.5rem; }
}
</style>
