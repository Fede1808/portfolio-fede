---
import { t, type Lang } from '../i18n/index.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;

const categories = [
  {
    key: 'mobile',
    items: ['React Native', 'Expo', 'Expo Router', 'iOS publishing', 'Android publishing', 'Push notifications (FCM/APNs)']
  },
  {
    key: 'frontend',
    items: ['TypeScript', 'JavaScript', 'Astro', 'Next.js', 'React', 'Tailwind CSS', 'vanilla CSS']
  },
  {
    key: 'backend',
    items: ['Supabase', 'PostgreSQL', 'Edge Functions', 'Supabase Auth', 'SQL', 'REST APIs', 'Python', 'Pandas', 'NumPy']
  },
  {
    key: 'ai',
    items: ['Claude Code', 'LLM APIs', 'Prompt engineering', 'Git', 'GitHub', 'CI/CD']
  },
  {
    key: 'soft',
    items: ['Requirements gathering', 'Client communication', 'Technical writing', 'Teaching / mentoring']
  }
];
---

<section id="skills" class="section" style="background: var(--color-bg-secondary);">
  <div class="section-inner">
    <div class="section-header fade-up">
      <span class="section-label">{t('skills.section_label', lang)}</span>
      <h2>{t('skills.title', lang)}</h2>
    </div>

    <div class="skills-grid">
      {categories.map((cat, i) => (
        <div class="skill-card card fade-up" data-delay={String(i * 60)}>
          <h3 class="skill-cat-name mono eyebrow" style="margin-bottom:1rem;">{t(`skills.${cat.key}`, lang)}</h3>
          <div class="skill-badges">
            {cat.items.map(item => <span class="skill-badge mono">{item}</span>)}
          </div>
        </div>
      ))}
    </div>

    <p class="skills-tagline fade-up" data-delay="300">
      <em>{t('skills.tagline', lang)}</em>
    </p>
  </div>
</section>

<style>
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
  margin-bottom: 2.5rem;
}

.skill-card { padding: 1.5rem; }

.skill-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.skill-badge {
  font-size: 0.75rem;
  padding: 0.25rem 0.625rem;
  border: 1px solid var(--color-border-default);
  border-radius: 4px;
  color: var(--color-text-secondary);
  background: var(--color-bg-primary);
  transition: border-color 200ms ease, color 200ms ease;
}

.skill-badge:hover {
  border-color: var(--color-border-hover);
  color: var(--color-text-primary);
}

.skills-tagline {
  text-align: center;
  font-size: 0.9375rem;
  color: var(--color-text-tertiary);
  font-style: normal;
}
</style>
