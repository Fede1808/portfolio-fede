---
import { profile } from '../data/profile.ts';
---

<section class="section cta" id="contacto">
  <div class="wrap">
    <div class="sec-hd"><span>Contacto</span><span class="ln"></span></div>
    <h2>Disponible para sumarme a un equipo</h2>
    <div class="cbtns">
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="btn" href={profile.github} rel="noopener">GitHub</a>
      <a class="btn" href={profile.linkedin} rel="noopener">LinkedIn</a>
      {profile.cv && <a class="btn" href={profile.cv} download>Descargar CV</a>}
    </div>
  </div>
</section>

<style>
  h2 {
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -.03em;
    margin: 0 0 16px;
    max-width: 24ch;
  }
  .cbtns { display: flex; flex-wrap: wrap; gap: 7px; }
</style>
