---
import Terminal from './Terminal.astro';
import { t, type Lang } from '../i18n/index.ts';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<section id="hero" class="hero-section">
  <!-- Subtle background -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="hero-container">
    <!-- Left: Content -->
    <div class="hero-content">
      <!-- Available dot -->
      <p class="hero-available mono">
        <span class="pulse-dot" style="color:var(--color-accent-primary);font-size:0.6rem;">●</span>
        {t('hero.available', lang)}
      </p>

      <!-- H1 -->
      <h1 class="hero-name">
        Federico Lopez Costanzo<span class="cursor-blink" style="color:var(--color-accent-primary)" aria-hidden="true">▊</span>
      </h1>

      <!-- Typewriter subtitle -->
      <div class="hero-subtitle-wrap" aria-live="polite">
        <span id="typewriter" class="hero-subtitle mono"></span>
      </div>

      <!-- Pitch -->
      <p class="hero-pitch">{t('hero.pitch', lang)}</p>

      <!-- CTAs -->
      <div class="hero-ctas">
        <a href="#work" class="btn btn-primary">{t('hero.cta_primary', lang)}</a>
        <a href="#contact" class="btn btn-ghost">{t('hero.cta_ghost', lang)}</a>
      </div>

      <!-- Mini stack -->
      <p class="hero-stack mono">Python · TypeScript · React Native · Astro · Supabase</p>
    </div>

    <!-- Right: Terminal -->
    <div class="hero-terminal">
      <Terminal />
    </div>
  </div>
</section>

<script is:inline define:vars={{ labels: ['Product Engineer', 'Full-Stack Developer', 'Mobile App Builder', 'AI-Native'] }}>
  const el = document.getElementById('typewriter');
  if (!el) throw new Error('typewriter not found');

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) { el.textContent = labels[0]; }
  else {
    let idx = 0, text = '', deleting = false;
    function tick() {
      const target = labels[idx];
      text = deleting ? target.slice(0, text.length - 1) : target.slice(0, text.length + 1);
      el.textContent = text;
      let delay = deleting ? 50 : 100;
      if (!deleting && text === target)  { delay = 2800; deleting = true; }
      else if (deleting && text === '')  { deleting = false; idx = (idx + 1) % labels.length; delay = 300; }
      setTimeout(tick, delay);
    }
    tick();
  }
</script>

<style>
.hero-section {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 8rem 1.5rem 5rem;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
  background-size: 60px 60px;
}

.hero-glow {
  position: absolute;
  top: -150px;
  left: -150px;
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(0,255,157,0.04) 0%, transparent 70%);
}

.hero-container {
  position: relative;
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  display: grid;
  grid-template-columns: 60fr 40fr;
  gap: 4rem;
  align-items: center;
}

.hero-content {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.hero-available {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8125rem;
  color: var(--color-text-secondary);
  letter-spacing: 0.05em;
  margin: 0;
}

.hero-name {
  color: var(--color-text-primary);
  line-height: 1.05;
}

.hero-subtitle-wrap { height: 2rem; display: flex; align-items: center; }

.hero-subtitle {
  font-size: 1.25rem;
  color: var(--color-accent-primary);
  letter-spacing: -0.01em;
}

.hero-pitch {
  font-size: 1.125rem;
  color: var(--color-text-secondary);
  max-width: 46ch;
  line-height: 1.7;
}

.hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }

.hero-stack {
  font-size: 0.8125rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.05em;
  margin: 0;
}

@media (max-width: 900px) {
  .hero-container {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .hero-section { padding-top: 6rem; }
}

@media (max-width: 480px) {
  .hero-ctas { flex-direction: column; align-items: flex-start; }
}
</style>
