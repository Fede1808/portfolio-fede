---
import { profile } from '../data/profile.ts';

const iniciales = profile.nombre
  .split(' ')
  .map(p => p[0])
  .slice(0, 2)
  .join('');
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="hero-grid">
      <div class="photo rise">
        {profile.foto
          ? <img src={profile.foto} alt={profile.nombre} width="132" height="132" />
          : (
            <>
              <span class="ini">{iniciales}</span>
              <span class="ph">foto pendiente</span>
            </>
          )
        }
      </div>

      <div class="rise">
        <p class="tagline">{profile.rol}</p>
        <h1>{profile.nombre}</h1>
        <p class="role">{profile.subtitulo}</p>
        <p class="intro">{profile.intro}</p>

        <div class="keys">
          <span class="key hi"><span class="d"></span><b>{profile.disponibilidad}</b></span>
          <span class="key"><b>{profile.ciudad}</b> · {profile.modalidad}</span>
          <span class="key">{profile.idiomas}</span>
        </div>

        <div class="hero-cta">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>Contactame</a>
          {profile.cv && <a class="btn" href={profile.cv} download>Descargar CV</a>}
          <a class="btn" href={profile.github} rel="noopener">GitHub</a>
          <a class="btn" href={profile.linkedin} rel="noopener">LinkedIn</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding: 56px 0 44px; border-bottom: 1px solid var(--line); }
  .hero-grid {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 30px;
    align-items: start;
  }
  @media (max-width: 700px) {
    .hero-grid { grid-template-columns: 1fr; gap: 22px; }
  }

  .photo {
    width: 132px;
    height: 132px;
    border-radius: var(--r);
    background: var(--surface-2);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    overflow: hidden;
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .ini { font-size: 2rem; font-weight: 600; color: var(--ink-3); letter-spacing: -.03em; }
  .ph {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 10px;
  }
  h1 {
    font-weight: 600;
    font-size: clamp(2rem, 4.8vw, 2.9rem);
    line-height: 1.05;
    letter-spacing: -.035em;
    margin: 0 0 6px;
  }
  .role {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--ink-2);
    margin: 0 0 18px;
    font-weight: 400;
  }
  .intro {
    font-size: 15.5px;
    line-height: 1.62;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0 0 20px;
  }

  .keys { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .key {
    display: flex;
    align-items: center;
    gap: 7px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 7px 12px;
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .key b { color: var(--ink); font-weight: 600; }
  .key.hi { border-color: var(--pos); background: var(--pos-soft); color: var(--pos); }
  .key.hi b { color: var(--pos); }
  .key .d { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 7px; }
</style>
