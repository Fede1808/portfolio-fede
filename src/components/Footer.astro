---
import { profile } from '../data/profile.ts';

const anio = new Date().getFullYear();
---

<footer class="ft">
  <div class="wrap ft-in">
    <span>© {anio} {profile.nombre}</span>
    <span>Hecho con Astro</span>
  </div>
</footer>

<style>
  .ft { border-top: 1px solid var(--line); }
  .ft-in {
    padding-top: 16px;
    padding-bottom: 34px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: var(--ink-3);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
