---
import { t, type Lang } from '../i18n/index.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-text mono">{t('footer.built', lang)}</p>
    <div class="footer-links">
      <a href="https://github.com/Fede1808" target="_blank" rel="noopener noreferrer" class="footer-link mono" aria-label="GitHub">gh</a>
      <a href="https://www.linkedin.com/in/federicolopezcostanzo/" target="_blank" rel="noopener noreferrer" class="footer-link mono" aria-label="LinkedIn">in</a>
    </div>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid var(--color-border-subtle);
  padding: 2rem 1.5rem;
}

.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.footer-text {
  font-size: 0.8125rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.02em;
  margin: 0;
}

.footer-links { display: flex; gap: 1rem; }

.footer-link {
  font-size: 0.75rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: color 200ms ease;
  text-decoration: none;
}

.footer-link:hover { color: var(--color-accent-primary); }

@media (max-width: 500px) {
  .footer-inner { flex-direction: column; text-align: center; }
}
</style>
