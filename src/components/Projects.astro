---
import { projects, estadoLabel } from '../data/projects.ts';

const tono = (estado: string) =>
  estado === 'produccion' || estado === 'uso' ? 'live' : 'wip';
---

<section class="section" id="proyectos">
  <div class="wrap">
    <div class="sec-hd">
      <span>Proyectos</span><span class="ln"></span><span>clic para ver el detalle</span>
    </div>

    <div class="projs">
      {projects.map(p => (
        <details class="proj">
          <summary>
            <span class="nm">{p.titulo}</span>
            <span class={`state ${tono(p.estado)}`}>
              <span class="dot"></span>{estadoLabel[p.estado]}
            </span>
            <span class="chev"><span class="lbl"></span></span>
            <span class="desc">{p.resumen}</span>
          </summary>

          <div class="proj-body">
            <div class="proj-cols">
              <div>
                <ul class="did">
                  {p.hizo.map(item => <li set:html={item} />)}
                </ul>

                {p.comparativa && (
                  <div class="mini">
                    <p class="t">{p.comparativa.titulo}</p>
                    <p class="n">{p.comparativa.nota}</p>
                    <div class="bars">
                      {p.comparativa.filas.map(f => (
                        <div class={`brow ${f.propio ? 'mine' : ''}`}>
                          <span class="nm2">{f.nombre}</span>
                          <span class="val">{f.valor}</span>
                          <span class="track">
                            <span class="fill" style={`width:${f.ancho}%`}></span>
                          </span>
                        </div>
                      ))}
                    </div>
                    <p class="ft" set:html={p.comparativa.pie} />
                  </div>
                )}

                <p class="techline"><b>Stack técnico</b>{p.stackTecnico}</p>
              </div>

              <div class="side">
                <div class="stack">
                  {p.chips.map(c => <span class="chip">{c}</span>)}
                </div>
                <div class="acts">
                  {p.links.map(l => (
                    <a href={l.url} rel="noopener">{l.texto} →</a>
                  ))}
                  {p.pendientes.map(t => <span class="pend">{t}</span>)}
                </div>
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .projs { display: flex; flex-direction: column; gap: 7px; }

  .proj {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
    transition: border-color .18s;
  }
  .proj:hover, .proj[open] { border-color: var(--ink-3); }

  .proj summary {
    list-style: none;
    cursor: pointer;
    padding: 14px 17px;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 8px 14px;
    align-items: center;
  }
  .proj summary::-webkit-details-marker { display: none; }

  .nm { font-size: 1.06rem; font-weight: 600; letter-spacing: -.02em; }
  .desc {
    font-size: 13.5px;
    color: var(--ink-2);
    grid-column: 1 / -1;
    line-height: 1.45;
    max-width: 72ch;
  }
  .chev {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-3);
    letter-spacing: .08em;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .chev::after {
    content: "▾";
    font-size: 11px;
    transition: transform .2s;
    display: inline-block;
  }
  .proj[open] .chev::after { transform: rotate(180deg); }
  .chev .lbl::after { content: "Ver detalle"; }
  .proj[open] .chev .lbl::after { content: "Cerrar"; }

  .state {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 100px;
    border: 1px solid;
  }
  .state.live { color: var(--pos); border-color: var(--pos); background: var(--pos-soft); }
  .state.wip { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
  .state .dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

  .proj-body {
    padding: 14px 17px 16px;
    border-top: 1px solid var(--line-soft);
  }
  .proj-cols { display: grid; grid-template-columns: 1fr 196px; gap: 22px; }
  @media (max-width: 780px) {
    .proj-cols { grid-template-columns: 1fr; gap: 15px; }
  }

  .did { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .did li {
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.5;
    padding-left: 15px;
    position: relative;
  }
  .did li::before {
    content: "";
    position: absolute;
    left: 0;
    top: .55em;
    width: 5px;
    height: 1px;
    background: var(--accent);
  }
  .did li :global(b) { color: var(--ink); font-weight: 600; }

  .techline {
    margin: 12px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-3);
    line-height: 1.65;
  }
  .techline b {
    color: var(--ink-2);
    font-weight: 400;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-size: 9px;
    display: block;
    margin-bottom: 3px;
  }

  .side { display: flex; flex-direction: column; gap: 10px; }
  @media (max-width: 780px) {
    .side { border-top: 1px solid var(--line-soft); padding-top: 13px; }
  }
  .stack { display: flex; flex-wrap: wrap; gap: 4px; }
  .acts { display: flex; flex-direction: column; gap: 5px; align-items: flex-start; }
  .acts a {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--accent);
    text-decoration: none;
    display: inline-flex;
    gap: 5px;
    transition: gap .18s;
  }
  .acts a:hover { gap: 9px; text-decoration: underline; }

  /* Comparativa del modelo */
  .mini {
    background: var(--surface-2);
    border: 1px solid var(--line-soft);
    border-radius: var(--r);
    padding: 13px 14px;
    margin-top: 13px;
  }
  .mini .t { font-size: 12.5px; font-weight: 600; margin: 0 0 3px; }
  .mini .n { font-size: 11.5px; color: var(--ink-2); margin: 0 0 11px; line-height: 1.45; }
  .bars { display: flex; flex-direction: column; gap: 8px; }
  .brow {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3px 10px;
    align-items: baseline;
  }
  .nm2 { font-size: 11px; color: var(--ink-2); }
  .val {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .track {
    grid-column: 1 / -1;
    height: 5px;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    border-radius: 1px;
    overflow: hidden;
  }
  .fill { display: block; height: 100%; background: var(--ink-3); }
  .brow.mine .nm2, .brow.mine .val { color: var(--accent); font-weight: 600; }
  .brow.mine .fill { background: var(--accent); }
  .mini .ft { font-size: 11px; color: var(--ink-2); margin: 11px 0 0; line-height: 1.45; }
  .mini .ft :global(b) { color: var(--ink); font-weight: 600; }
</style>
