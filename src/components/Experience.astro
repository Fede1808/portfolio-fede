---
import { experiencia } from '../data/experience.ts';
---

<section class="section" id="experiencia">
  <div class="wrap">
    <div class="sec-hd"><span>Experiencia</span><span class="ln"></span></div>

    <ol class="exp">
      {experiencia.map(e => (
        <li class="exp-item">
          <span class="exp-when">{e.periodo}</span>
          <div class="exp-what">
            <h3>{e.puesto} <span>· {e.lugar}</span></h3>
            <p>{e.descripcion}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .exp { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .exp-item {
    display: grid;
    grid-template-columns: 118px 1fr;
    gap: 20px;
    padding: 14px 0;
    border-top: 1px solid var(--line-soft);
  }
  .exp-item:first-child { border-top: none; padding-top: 0; }
  @media (max-width: 640px) {
    .exp-item { grid-template-columns: 1fr; gap: 5px; }
  }

  .exp-when {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-3);
    letter-spacing: .05em;
    padding-top: 3px;
  }
  .exp-what h3 {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 3px;
    letter-spacing: -.012em;
  }
  .exp-what h3 span { font-weight: 400; color: var(--ink-2); }
  .exp-what p {
    font-size: 13.5px;
    color: var(--ink-2);
    margin: 0;
    line-height: 1.5;
    max-width: 64ch;
  }
</style>
