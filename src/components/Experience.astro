---
import { t, type Lang } from '../i18n/index.ts';
interface Props { lang: Lang }
const { lang } = Astro.props;

const entries = [
  {
    period: '2025 — present',
    role: 'Product Engineer',
    company: 'Freelance',
    description: 'Construyendo productos para clientes y proyectos propios.',
    description_en: 'Building products for clients and personal projects.',
    stack: 'React Native · Astro · Supabase · AI-assisted dev'
  },
  {
    period: '2023 — present',
    role: 'Docente de Informática',
    role_en: 'Computer Science Teacher',
    company: 'Instituto José Peña',
    description: 'Enseñanza de programación, algoritmos y lógica computacional a estudiantes de 12–14 años. Diseño de currículum y materiales.',
    description_en: 'Teaching programming, algorithms and computational logic to 12–14 year old students. Curriculum and material design.',
    stack: null
  }
];
---

<section id="experience" class="section">
  <div class="section-inner">
    <div class="section-header fade-up">
      <span class="section-label">{t('experience.section_label', lang)}</span>
      <h2>{t('experience.title', lang)}</h2>
    </div>

    <div class="timeline">
      {entries.map((entry, i) => (
        <div class="timeline-entry fade-up" data-delay={String(i * 80)}>
          <span class="entry-period mono">{entry.period}</span>
          <div class="entry-body">
            <div class="entry-role-line">
              <strong class="entry-role">{lang === 'en' && entry.role_en ? entry.role_en : entry.role}</strong>
              <span class="entry-sep mono"> · </span>
              <span class="entry-company">{entry.company}</span>
            </div>
            <p class="entry-desc">{lang === 'en' ? entry.description_en : entry.description}</p>
            {entry.stack && <p class="entry-stack mono">{entry.stack}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.timeline {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  padding-left: 1rem;
  border-left: 1px solid var(--color-border-subtle);
  margin-top: 0.5rem;
}

.timeline-entry {
  display: grid;
  grid-template-columns: 160px 1fr;
  gap: 1.5rem;
  padding-left: 1.5rem;
  position: relative;
}

.timeline-entry::before {
  content: '';
  position: absolute;
  left: -5px;
  top: 0.4rem;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--color-accent-primary);
  box-shadow: 0 0 8px rgba(0,255,157,0.4);
}

.entry-period {
  font-size: 0.8125rem;
  color: var(--color-accent-primary);
  letter-spacing: 0.02em;
  padding-top: 0.1rem;
  white-space: nowrap;
}

.entry-role-line {
  display: flex;
  align-items: baseline;
  gap: 0.25rem;
  flex-wrap: wrap;
  margin-bottom: 0.375rem;
}

.entry-role { font-weight: 600; color: var(--color-text-primary); }
.entry-sep { color: var(--color-border-hover); }
.entry-company { color: var(--color-text-secondary); }

.entry-desc {
  color: var(--color-text-secondary);
  font-size: 0.9375rem;
  line-height: 1.65;
  margin-bottom: 0.375rem;
}

.entry-stack {
  font-size: 0.8125rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.02em;
  margin: 0;
}

@media (max-width: 600px) {
  .timeline-entry { grid-template-columns: 1fr; gap: 0.5rem; }
}
</style>
