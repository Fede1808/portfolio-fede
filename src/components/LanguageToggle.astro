---
import type { Lang } from '../i18n/index.ts';
interface Props { currentLang: Lang }
const { currentLang } = Astro.props;
---

<div class="lang-toggle" role="group" aria-label="Language / Idioma">
  <button
    class:list={['lang-btn mono', { active: currentLang === 'es' }]}
    data-lang="es"
    aria-pressed={currentLang === 'es'}
    aria-label="Español"
  >ES</button>
  <span class="lang-sep mono" aria-hidden="true">|</span>
  <button
    class:list={['lang-btn mono', { active: currentLang === 'en' }]}
    data-lang="en"
    aria-pressed={currentLang === 'en'}
    aria-label="English"
  >EN</button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang;
      if (!lang) return;
      localStorage.setItem('lang', lang);
      const path = window.location.pathname;
      if (lang === 'en' && !path.startsWith('/en')) {
        window.location.href = '/en/';
      } else if (lang === 'es' && path.startsWith('/en')) {
        window.location.href = '/';
      }
    });
  });
</script>

<style>
.lang-toggle { display: flex; align-items: center; gap: 0.125rem; }
.lang-sep { color: var(--color-border-default); font-size: 0.75rem; padding: 0 0.125rem; }
.lang-btn {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  color: var(--color-text-tertiary);
  padding: 0.25rem 0.375rem;
  border-radius: 3px;
  transition: color 200ms ease;
}
.lang-btn:hover { color: var(--color-text-primary); }
.lang-btn.active { color: var(--color-accent-primary); }
</style>
