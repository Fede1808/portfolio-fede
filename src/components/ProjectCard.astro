---
import type { Project } from '../data/projects.ts';
import { t, type Lang } from '../i18n/index.ts';

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const desc = project.description[lang];
const howBuilt = project.howBuilt?.[lang];
---

<article class:list={['project-card', { featured: project.featured }]}>
  {project.featured ? (
    <!-- Featured: full-width layout -->
    <div class="featured-inner">
      <div class="featured-content">
        <!-- Header -->
        <div class="project-header">
          <span class="project-tag mono eyebrow">{project.tag}</span>
          {project.client && <span class="project-client mono">{project.client}</span>}
          <div class="project-badges">
            <span class="badge mono">Live on App Store</span>
            <span class="badge mono">Live on Google Play</span>
            <span class="badge-note mono">// TODO: REVIEW — add store links when published</span>
          </div>
        </div>

        <h3 class="project-title">{project.title}</h3>
        <p class="project-desc">{desc}</p>

        <!-- Metrics -->
        {project.metrics && (
          <div class="metrics-grid">
            {project.metrics.map(m => (
              <div class="metric">
                <span class="metric-value mono">{m.value}</span>
                <span class="metric-label mono">{m.label}</span>
                <span class="metric-sub mono">{m.sublabel}</span>
              </div>
            ))}
          </div>
        )}

        <!-- Highlights -->
        <ul class="highlights-list">
          {project.highlights.map(h => (
            <li class="highlight-item"><span class="highlight-arrow" aria-hidden="true">&gt;</span> {h}</li>
          ))}
        </ul>

        <!-- Stack -->
        <div class="stack-badges">
          {project.stack.map(s => <span class="stack-badge mono">{s}</span>)}
        </div>

        <!-- How built -->
        {howBuilt && (
          <details class="how-built">
            <summary class="how-built-label mono">{t('work.how_built_label', lang)}</summary>
            <p class="how-built-text">{howBuilt}</p>
          </details>
        )}

        <!-- CTAs -->
        <div class="project-ctas">
          {project.links.appStore
            ? <a href={project.links.appStore} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">{t('work.view_appstore', lang)}</a>
            : <span class="btn btn-ghost btn-sm disabled" aria-disabled="true">{t('work.view_appstore', lang)} — {t('work.link_placeholder', lang)}</span>
          }
          {project.links.googlePlay
            ? <a href={project.links.googlePlay} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">{t('work.view_googleplay', lang)}</a>
            : <span class="btn btn-ghost btn-sm disabled" aria-disabled="true">{t('work.view_googleplay', lang)} — {t('work.link_placeholder', lang)}</span>
          }
          {project.links.demo && (
            <a href={project.links.demo} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">{t('work.view_demo', lang)}</a>
          )}
        </div>
      </div>

      <!-- Screenshots placeholder -->
      <div class="featured-visual">
        {project.screenshots.length > 0
          ? project.screenshots.map(src => <img src={src} alt={`${project.title} screenshot`} class="screenshot" loading="lazy" />)
          : (
            <div class="screenshot-placeholder">
              <span class="mono" style="color:var(--color-text-tertiary);font-size:0.8125rem;">
                // TODO: REVIEW — add screenshots to /public/projects/azul/
              </span>
              <p class="mono" style="color:var(--color-text-tertiary);font-size:0.75rem;margin-top:0.5rem;">
                {t('work.screenshot_placeholder', lang)}
              </p>
            </div>
          )
        }
      </div>
    </div>
  ) : (
    <!-- Standard card -->
    <div class="card-inner">
      <div class="project-header">
        <span class="project-tag mono eyebrow">{project.tag}</span>
        <span class="project-year mono">{project.year}</span>
      </div>
      <h3 class="project-title">{project.title}</h3>
      <p class="project-subtitle mono">{project.subtitle}</p>
      <p class="project-desc">{desc}</p>

      <ul class="highlights-list">
        {project.highlights.map(h => (
          <li class="highlight-item"><span class="highlight-arrow" aria-hidden="true">&gt;</span> {h}</li>
        ))}
      </ul>

      <div class="stack-badges">
        {project.stack.map(s => <span class="stack-badge mono">{s}</span>)}
      </div>

      <div class="project-ctas">
        {project.links.demo
          ? <a href={project.links.demo} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">{t('work.view_demo', lang)}</a>
          : <span class="btn btn-ghost btn-sm disabled" aria-disabled="true">Demo — {t('work.link_placeholder', lang)}</span>
        }
        {project.links.github
          ? <a href={project.links.github} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">{t('work.view_github', lang)}</a>
          : <span class="btn btn-ghost btn-sm disabled" aria-disabled="true">GitHub — {t('work.link_placeholder', lang)}</span>
        }
      </div>
    </div>
  )}
</article>

<style>
.project-card {
  border: 1px solid var(--color-border-default);
  border-radius: 12px;
  background: var(--color-bg-elevated);
  transition: border-color 200ms ease;
  overflow: hidden;
}
.project-card:hover { border-color: var(--color-border-hover); }

/* Featured */
.featured { border-color: rgba(0,255,157,0.15); }
.featured:hover { border-color: rgba(0,255,157,0.3); }
.featured-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}
.featured-content { padding: 2.5rem; }
.featured-visual {
  background: var(--color-bg-secondary);
  border-left: 1px solid var(--color-border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  min-height: 400px;
}

/* Card inner */
.card-inner { padding: 2rem; }

.project-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1rem;
  flex-wrap: wrap;
}
.project-tag { font-size: 0.75rem; }
.project-client { font-size: 0.75rem; color: var(--color-text-tertiary); }
.project-year { font-size: 0.75rem; color: var(--color-text-tertiary); margin-left: auto; }

.project-badges { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
.badge {
  font-size: 0.6875rem;
  padding: 0.2rem 0.6rem;
  border: 1px solid rgba(0,255,157,0.3);
  border-radius: 4px;
  color: var(--color-accent-primary);
}
.badge-note { font-size: 0.6875rem; color: var(--color-text-tertiary); }

.project-title { font-size: 1.75rem; font-weight: 600; margin-bottom: 0.75rem; letter-spacing: -0.02em; }
.project-subtitle { font-size: 0.875rem; color: var(--color-text-secondary); margin-bottom: 0.75rem; }
.project-desc { color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 1.5rem; }

/* Metrics */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding: 1.25rem;
  background: var(--color-bg-secondary);
  border-radius: 8px;
  border: 1px solid var(--color-border-subtle);
}
.metric { display: flex; flex-direction: column; gap: 0.1rem; }
.metric-value { font-size: 2rem; font-weight: 700; color: var(--color-accent-primary); line-height: 1; }
.metric-label { font-size: 0.75rem; color: var(--color-text-tertiary); text-transform: uppercase; letter-spacing: 0.05em; }
.metric-sub { font-size: 0.6875rem; color: var(--color-text-tertiary); }

/* Highlights */
.highlights-list { list-style: none; padding: 0; margin: 0 0 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
.highlight-item { font-size: 0.9rem; color: var(--color-text-secondary); display: flex; gap: 0.5rem; }
.highlight-arrow { color: var(--color-accent-primary); flex-shrink: 0; }

/* Stack */
.stack-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
.stack-badge {
  font-size: 0.75rem;
  padding: 0.25rem 0.625rem;
  border: 1px solid var(--color-border-default);
  border-radius: 4px;
  color: var(--color-text-secondary);
}

/* How built */
.how-built { margin-bottom: 1.5rem; }
.how-built-label {
  cursor: pointer;
  font-size: 0.8125rem;
  color: var(--color-text-tertiary);
  letter-spacing: 0.05em;
  list-style: none;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.how-built-label::before { content: '▶'; font-size: 0.5rem; transition: transform 200ms; }
details[open] .how-built-label::before { transform: rotate(90deg); }
.how-built-text { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.7; margin-top: 0.75rem; }

/* CTAs */
.project-ctas { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }

/* Screenshot */
.screenshot-placeholder {
  border: 1px dashed var(--color-border-default);
  border-radius: 8px;
  padding: 3rem 2rem;
  text-align: center;
  width: 100%;
}
.screenshot { border-radius: 8px; max-width: 100%; }

@media (max-width: 768px) {
  .featured-inner { grid-template-columns: 1fr; }
  .featured-visual { border-left: none; border-top: 1px solid var(--color-border-subtle); min-height: 200px; }
  .metrics-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>
