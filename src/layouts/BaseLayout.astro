---
import '../styles/global.css';
import { profile } from '../data/profile.ts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.nombre} · ${profile.rol}`,
  description =
    'Desarrollador Full-Stack y Mobile en Córdoba, Argentina. Último año de Ingeniería en ' +
    'Software. App móvil en producción para una distribuidora. Disponible full-time.',
} = Astro.props;

const site = Astro.site ?? 'https://federicolopezcostanzo.com';
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og.png', site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href="/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/geist-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/geist-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Federico López Costanzo',
      email: 'fede.fl73@gmail.com',
      url: 'https://federicolopezcostanzo.com',
      jobTitle: 'Desarrollador Full-Stack & Mobile',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Córdoba',
        addressCountry: 'AR',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Universidad Siglo 21',
      },
      knowsAbout: ['TypeScript', 'React Native', 'Next.js', 'Supabase', 'PostgreSQL', 'Python'],
      sameAs: ['https://www.linkedin.com/in/federicolopezcostanzo/', 'https://github.com/Fede1808'],
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
